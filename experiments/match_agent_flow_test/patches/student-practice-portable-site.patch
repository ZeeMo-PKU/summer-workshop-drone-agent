diff --git a/b/scripts/set-portable-site.ps1 b/b/scripts/set-portable-site.ps1
new file mode 100644
index 0000000..a335829
--- /dev/null
+++ b/b/scripts/set-portable-site.ps1
@@ -0,0 +1,88 @@
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory = $true)]
+    [ValidateRange(-90, 90)]
+    [double]$ReferenceLatitude,
+
+    [Parameter(Mandatory = $true)]
+    [ValidateRange(-180, 180)]
+    [double]$ReferenceLongitude,
+
+    [Parameter(Mandatory = $true)]
+    [double]$ReferenceAltitude,
+
+    [Parameter(Mandatory = $true)]
+    [ValidateRange(-360, 360)]
+    [double]$HeadingDegrees
+)
+
+$ErrorActionPreference = "Stop"
+$scriptDirectory = Split-Path -Parent $MyInvocation.MyCommand.Path
+$packageRoot = [System.IO.Path]::GetFullPath((Join-Path $scriptDirectory ".."))
+$configPath = Join-Path $packageRoot "config\student-practice.json"
+$backupRoot = Join-Path $packageRoot "config\backups"
+
+foreach ($value in @(
+    $ReferenceLatitude,
+    $ReferenceLongitude,
+    $ReferenceAltitude,
+    $HeadingDegrees
+)) {
+    if ([double]::IsNaN($value) -or [double]::IsInfinity($value)) {
+        throw "Site calibration values must be finite numbers."
+    }
+}
+
+if (-not (Test-Path -LiteralPath $configPath -PathType Leaf)) {
+    throw "Configuration file not found: $configPath"
+}
+
+$settings = Get-Content -LiteralPath $configPath -Raw -Encoding UTF8 |
+    ConvertFrom-Json
+$port = [int]$settings.httpPort
+$connection = Get-NetTCPConnection -LocalAddress 127.0.0.1 -LocalPort $port `
+    -State Listen -ErrorAction SilentlyContinue
+if ($connection) {
+    throw "The monitor is still listening on 127.0.0.1:$port. Stop it before calibration."
+}
+
+$fieldRotationDegrees = $HeadingDegrees - 90.0
+while ($fieldRotationDegrees -le -180.0) {
+    $fieldRotationDegrees += 360.0
+}
+while ($fieldRotationDegrees -gt 180.0) {
+    $fieldRotationDegrees -= 360.0
+}
+
+New-Item -ItemType Directory -Path $backupRoot -Force | Out-Null
+$timestamp = Get-Date -Format "yyyyMMdd-HHmmss"
+$backupPath = Join-Path $backupRoot "student-practice-$timestamp.json"
+Copy-Item -LiteralPath $configPath -Destination $backupPath
+
+$settings.portableSite.enabled = $true
+$settings.portableSite.horizontalRadiusMeters = 20
+$settings.portableSite.maximumAltitudeMeters = 10
+$settings.calibration.referenceLatitude = $ReferenceLatitude
+$settings.calibration.referenceLongitude = $ReferenceLongitude
+$settings.calibration.referenceAltitude = $ReferenceAltitude
+$settings.calibration.fieldRotationDegrees = $fieldRotationDegrees
+$settings.calibration.fieldOriginX = 0
+$settings.calibration.fieldOriginY = 1
+$settings.calibration.fieldOriginZ = 0
+$settings.calibration.droneReferenceOffsetX = 0
+$settings.calibration.droneReferenceOffsetY = 0
+$settings.calibration.droneReferenceOffsetZ = 0
+
+$json = $settings | ConvertTo-Json -Depth 8
+[System.IO.File]::WriteAllText(
+    $configPath,
+    $json + [Environment]::NewLine,
+    [System.Text.UTF8Encoding]::new($false)
+)
+
+Write-Host "Portable site calibration updated." -ForegroundColor Green
+Write-Host "Launch point: $ReferenceLatitude, $ReferenceLongitude, $ReferenceAltitude"
+Write-Host "Field +X heading: $HeadingDegrees degrees"
+Write-Host "Safety envelope: 20 m horizontal radius, 10 m relative altitude"
+Write-Host "Previous configuration backup: $backupPath"
+Write-Host "Before launch, keep the aircraft disarmed at this point with its nose facing field +X." -ForegroundColor Yellow
